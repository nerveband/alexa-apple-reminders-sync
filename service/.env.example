# Copy this file to .env and fill it in. Never share your .env file.

# A long random password that n8n uses to talk to this service.
# Make one with:  openssl rand -hex 32
BRIDGE_TOKEN=

# Your Apple ID email and password. Two-factor is fine.
APPLE_ID=
APPLE_PASSWORD=

# The exact name of the Apple Reminders list to sync.
APPLE_LIST_NAME=Family

# The Echo or Echos that should speak reminders you add on the Apple side.
# Use device names from the Alexa app, or serial numbers (they never change).
# Separate more than one with commas.
ALEXA_DEVICES=Kitchen

# Which Alexa lists to sync. TODO is the To-Do list, SHOP is the Shopping list.
# Apple items with no time go to the first one.
ALEXA_LISTS=TODO,SHOP

# Optional. An OpenRouter key turns on AI sorting of new Alexa items into sections.
# Leave empty to skip sorting.
OPENROUTER_API_KEY=
SORT_MODEL=google/gemini-2.5-flash-lite

# Your Amazon email. Only used by alexa_login.py.
ALEXA_EMAIL=

# The Docker network your n8n container is on.
# Find it with:  docker inspect YOUR_N8N_CONTAINER --format '{{json .NetworkSettings.Networks}}'
N8N_NETWORK=n8n_default
