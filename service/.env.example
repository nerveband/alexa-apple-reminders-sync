# Copy this file to .env and fill it in. Never share your .env file.

# A long random password that n8n uses to talk to this service.
# Make one with:  openssl rand -hex 32
BRIDGE_TOKEN=

# Your Apple ID email and password. Two-factor is fine.
APPLE_ID=
APPLE_PASSWORD=

# The exact name of the Apple Reminders list to sync.
APPLE_LIST_NAME=Family

# The Echo that should speak reminders you add on the Apple side.
# Use the device name from the Alexa app, like Kitchen.
ALEXA_DEFAULT_DEVICE=Kitchen

# Your Amazon email. Only used by alexa_login.py.
ALEXA_EMAIL=

# The Docker network your n8n container is on.
# Find it with:  docker inspect YOUR_N8N_CONTAINER --format '{{json .NetworkSettings.Networks}}'
N8N_NETWORK=n8n_default
