        "url": "http://reminders-sync:8787/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 240000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "name": "Run sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "id": "d69f6473-9383-5537-a31c-1c7fcc150482",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Decide if this run needs an alert. Alerts are rate-limited so an outage does not spam you.\nconst FORM_URL = 'https://YOUR-N8N-DOMAIN/form/icloud-code';\nconst sd = $getWorkflowStaticData('global');\nconst r = $input.first().json;\nconst body = (r && typeof r.body === 'object' && r.body) ? r.body : r;\nconst status = r.statusCode || (r.error ? 0 : 200);\nconst errors = (body && Array.isArray(body.errors)) ? body.errors : (r.error ? [String(r.error.message || r.error)] : []);\nconst ok = status === 200 && errors.length === 0;\nconst needsCode = body && body.icloud === 'needs_2fa';\nsd.failStreak = ok ? 0 : (sd.failStreak || 0) + 1;\nlet alert = '';\nif (needsCode) {\n  if (Date.now() - (sd.lastCodeAlert || 0) > 6 * 3600000) {\n    sd.lastCodeAlert = Date.now();\n    alert = 'Reminders sync: Apple needs a new verification code. Open ' + FORM_URL + ' and follow the steps.';\n  }\n} else if (!ok && (sd.failStreak === 5 || (sd.failStreak > 5 && sd.failStreak % 180 === 0))) {\n  alert = 'Reminders sync has failed ' + sd.failStreak + ' runs in a row: ' + errors.join(' | ').slice(0, 400);\n}\nif (ok) sd.lastCodeAlert = 0;\nreturn [{ json: { ok, alert, result: body } }];\n"
      },
      "name": "Check result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "cd0ff327-8e96-5ec6-9fa9-504092262179"
    },
    {
